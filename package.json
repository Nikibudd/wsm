{
  "name": "workspace-manager",
  "version": "1.0.0",
  "description": "Fast CLI/TUI workspace switcher for coding projects",
  "private": true,
  "type": "module",
  "bin": {
    "wsm": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
