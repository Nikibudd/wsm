    "react": "^19.2.8"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "babel-jest": "^30.5.1",
    "ink-testing-library": "^4.0.0",
    "jest": "^30.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
